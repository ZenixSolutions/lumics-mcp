# Lumics MCP Server — example configuration
#
# Copy to .env for local development. NEVER commit a real .env file.
# All values below are placeholders. See SECURITY.md before you begin.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your Lumics API token (a JWT bearer token).
#
# Obtain one by logging into the Lumics web UI and visiting /api/v1/me/token,
# or by POSTing your credentials:
#
#   curl -X POST -H 'Content-Type: application/x-www-form-urlencoded' \
#     --data 'username=you@example.com&password=YOUR_PASSWORD' \
#     'https://app.lumics.io/api/v1/me/token?expiresIn=86400'
#
# SECURITY: tokens default to 86400 seconds (1 day). The Lumics API accepts an
# `expiresIn` query parameter to request longer, and documents no maximum.
# Prefer the shortest lifetime that works for you and rotate regularly. A
# leaked token grants full API access as your user, and the only revocation
# mechanism revokes EVERY token on your account at once.
LUMICS_TOKEN=replace-me

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Your Lumics company id (24-character hex).
#
# OPTIONAL, but you want it set: almost every tool is scoped to a company, and
# without this the server starts with ONLY the tools that need no company —
# lumics_get_me, lumics_get_device_definition_components,
# lumics_get_device_metrics and lumics_get_device_item_metrics (plus
# lumics_revoke_tokens if you have enabled it). It logs a warning saying so.
#
# First run: leave this unset, start the server, call lumics_get_me, set this
# variable to the company id it returns, and restart. You can also read the id
# out of the Lumics web UI URL after /companies/.
#
# A value that IS supplied is still validated at startup: it must be 24 hex
# characters, so a typo fails immediately rather than as a 404 mid-conversation.
# LUMICS_COMPANY_ID=000000000000000000000000

# API base URL. Override only for a self-hosted or non-production Lumics.
# LUMICS_BASE_URL=https://app.lumics.io/api/v1

# Request timeout in milliseconds.
# LUMICS_TIMEOUT_MS=30000

# Maximum characters of tool output before truncation is applied and disclosed.
# LUMICS_MAX_OUTPUT_CHARS=25000

# ---------------------------------------------------------------------------
# Safety switches (recommended)
# ---------------------------------------------------------------------------

# Register ONLY read-only tools. Strongly recommended unless you specifically
# need to modify your Lumics data. With this set, no create, update, delete, or
# admin tool is exposed to the model at all.
# LUMICS_READ_ONLY=1

# Allow a tool call to name a company other than LUMICS_COMPANY_ID.
#
# Off by default. Every tool takes an optional companyId argument; with this
# unset, an explicit companyId that differs from LUMICS_COMPANY_ID is refused
# with a not_permitted error. One Lumics token can reach every company its user
# administers, so without this gate a model holding another tenant's id could
# read or write there — while the tool description said the call applied to the
# configured company. Set it only if you genuinely operate several tenants
# through one server, and read SECURITY.md first: it widens the blast radius
# from one company to every company the token can reach.
# LUMICS_ALLOW_CROSS_COMPANY=1

# Allow bulk device updates. Off by default: a single call can rewrite
# arbitrary fields on many devices at once.
# LUMICS_ENABLE_BATCH_UPDATE=1

# Allow the token-revocation tool. Off by default, and for good reason: it
# revokes EVERY token on your account, including the one this server is using.
# LUMICS_ENABLE_TOKEN_REVOCATION=1

# ---------------------------------------------------------------------------
# HTTP transport — NOT AVAILABLE IN 0.1.0, documented for v0.2
# ---------------------------------------------------------------------------
#
# Every variable in this block is inert in 0.1.0. The release ships stdio only
# (ADR-001 decision 3) and opens no network listener at all.
#
# Setting LUMICS_TRANSPORT to "http" is REFUSED at startup: the server exits
# with a message pointing at ADR-001 and v0.2 rather than quietly opening a port
# that three documents say does not exist. The values below are documented now
# so a v0.2 deployment can be prepared and reviewed in advance — they do nothing
# yet.

# Transport selection. "stdio" is the default and the only value 0.1.0 accepts;
# "http" is refused at startup until v0.2.
# LUMICS_TRANSPORT=stdio

# v0.2 only. HTTP listener. Binds to loopback by default; change the host only
# when you have terminated TLS and authentication in front of it.
# LUMICS_HTTP_PORT=3000
# LUMICS_HTTP_HOST=127.0.0.1

# v0.2 only. Shared secret clients must present as
# `Authorization: Bearer <value>`. Required when LUMICS_TRANSPORT=http, minimum
# 32 characters. Generate with: openssl rand -hex 32
# LUMICS_HTTP_AUTH_TOKEN=replace-me

# v0.2 only. Comma-separated allowlists for DNS-rebinding and CORS protection.
#
# Setting LUMICS_HTTP_ALLOWED_HOSTS REPLACES the default list rather than adding
# to it, so include every loopback spelling you actually use. The default is
# 127.0.0.1, localhost and [::1], plus the bind host; the example below repeats
# it in full. Omitting [::1] is the easy mistake — an IPv6-loopback client then
# gets "403 Invalid Host: [::1]", which reads as a server fault rather than as
# your own allowlist.
# LUMICS_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# LUMICS_HTTP_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Contract tests (maintainers only)
# ---------------------------------------------------------------------------

# Opt in to tests that make real API calls against a live tenant. These are
# read-only but they do consume quota. Run before a release.
# LUMICS_CONTRACT_TESTS=1
